{
  "name": "mermaid-previewer",
  "displayName": "Mermaid Previewer",
  "version": "1.5.3",
  "description": "Preview and export mermaid.",
  "type": "module",
  "scripts": {
    "dev": "node tools/prepare-assets.mjs && extension dev --browser=chrome",
    "test": "playwright test",
    "test-ui": "playwright test --ui",
    "test-report": "playwright show-report",
    "build": "node tools/prepare-assets.mjs && extension build --browser=chrome",
    "package": "node tools/prepare-assets.mjs && extension build --browser=chrome --zip --zip-filename=mermaid-previewer",
    "gcp-token": "pnpm dlx gcp-refresh-token@0.9.2",
    "dep-outdate": "pnpm outdated",
    "format": "pnpm exec prettier '**/*.{js,ts,jsx,tsx,cjs,cts,mjs,mts,vue,astro}' --write --ignore-unknown",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zephyraft/mermaid-previewer.git"
  },
  "keywords": [
    "chrome-extension",
    "mermaid"
  ],
  "author": "zephyraft",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zephyraft/mermaid-previewer/issues"
  },
  "homepage": "https://github.com/zephyraft/mermaid-previewer#readme",
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@fluentui/react-components": "9.75.2",
    "@fluentui/react-icons": "2.0.347",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.10",
    "extension": "4.2.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.13.1",
    "pnpm": ">=12.22.0"
  },
  "packageManager": "pnpm@12.22.0"
}
