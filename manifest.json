{
  "manifest_version": 3,
  "name": "Mermaid Previewer",
  "version": "1.5.4",
  "description": "Preview Mermaid diagrams right on the page, copy their source, and download SVGs.",
  "author": "zephyraft",
  "homepage_url": "https://github.com/zephyraft/mermaid-previewer#readme",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.ts"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "downloads", "activeTab", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"]
}
