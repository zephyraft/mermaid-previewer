{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowArbitraryExtensions": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "types": ["chrome", "node"],
    "skipLibCheck": true,
    "noImplicitAny": true,
    "paths": {
      "~*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}
